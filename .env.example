# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string (e.g. `openssl rand -hex 32`). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Secret passphrase users send as `/login <code>` to unlock the bot.
ACCESS_CODE=

GEMINI_API_KEY=
# GSubz API key: https://gsubz.com/dashboard/key.php
GSUBZ_API_KEY=

# Upstash Redis (or Vercel's Upstash integration, which sets KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# MAX_PURCHASE_NGN=10000
# GEMINI_MODEL=gemini-3.1-flash-lite
# Owner-only: comma-separated Telegram user IDs allowed to see wallet info (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=
# Owner-only: text shown by /balance, e.g. "Bank - 0123456789 - Your Name" (copy from your GSubz dashboard)
GSUBZ_ACCOUNT_DETAILS=
#end